# Copy to .env; keep actual keys in this ignored local file.
NAVDIAG_PROVIDER=offline

# Prefer dashboard > Diagnostics > Configure model/API to save named connections.
# Alternative CLI/environment configuration for any Chat Completions-compatible service:
# NAVDIAG_PROVIDER=compatible
# NAVDIAG_MODEL=your-model-id
# NAVDIAG_BASE_URL=https://your-service.example/v1
# NAVDIAG_ANSWER_MODE=evidence
# NAVDIAG_REASONING_EFFORT=default
# Local Ollama can use http://127.0.0.1:11434/v1 with an empty key.

# Fill only locally. Do not send keys to a chat or commit them.
NAVDIAG_API_KEY=

# Local retrieval: auto uses the optional local BGE encoder when prepared.
# sparse never initializes an encoder; missing/broken weights use sparse fallback.
# Set these in the shell environment, not this .env file or connection profiles:
# $env:NAVDIAG_RETRIEVAL_MODE='auto'
# $env:NAVDIAG_EMBEDDING_MODEL_DIR='/path/to/bge-small-zh-v1.5'
