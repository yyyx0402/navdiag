{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NavDiag: satellite LOS/NLOS experiment",
      "type": "debugpy",
      "request": "launch",
      "module": "navdiag",
      "args": ["train-nlos"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NavDiag: demo experiment",
      "type": "debugpy",
      "request": "launch",
      "module": "navdiag",
      "args": [
        "demo",
        "--navigation",
        "--with-gru",
        "--out",
        "artifacts/navigation_demo"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NavDiag: dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "navdiag",
      "args": [
        "serve",
        "--artifacts",
        "artifacts/urbannav_positioning",
        "--nlos-artifacts",
        "artifacts/klt_protocols",
        "--generalization-artifacts",
        "artifacts/urbannav_generalization"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
